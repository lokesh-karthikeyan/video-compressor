{
  "name": "video-compressor",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.1.0"
    }
  },
  "workspaces": ["apps/*", "packages/*"],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.8.1",
    "turbo": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "scripts": {
    "dev:frontend": "bun run --env-file=../../.env --cwd apps/web/ dev",
    "dev:backend": "bun run --env-file=../../.env --cwd apps/api dev",
    "dev:worker": "bun run --env-file=../../.env --cwd apps/worker dev",
    "db:generate": "bun run --env-file=../../.env --cwd packages/database db:generate",
    "db:migrate": "bun run --env-file=../../.env --cwd packages/database db:migrate",
    "db:studio": "bun run --env-file=../../.env --cwd packages/database db:studio"
  }
}
