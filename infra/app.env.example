DATABASE_URL=file:///data/local.db

JWT_SECRET=docker-dev-jwt-secret-change-me-in-production-9f8e7d6c5b4a3210
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PORT=3000
FRONTEND_URL=http://localhost:5173

S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_BUCKET=video-compressor
S3_REGION=garage
S3_ACCESS_KEY_FILE=/run/garage-creds/s3_access_key
S3_SECRET_KEY_FILE=/run/garage-creds/s3_secret_key

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE=video-compression
RABBITMQ_PROGRESS_QUEUE=video-progress
RABBITMQ_COMPLETION_QUEUE=video-completion

MAX_FILE_SIZE=524288000
